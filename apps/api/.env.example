# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_db
PORT=3001

# Redis (BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth — always set this. The code falls back to a hardcoded
# default if it is missing, which is unsafe outside local dev.
JWT_SECRET=

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=reports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Outbound email, used for team invites
SMTP_URL=

# AI gateway (OpenAI-compatible endpoint)
OMNIROUTE_URL=http://localhost:20128/v1

# Optional direct provider keys, if you swap out the gateway
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
