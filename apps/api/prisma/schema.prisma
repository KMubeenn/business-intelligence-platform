generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  dataSources     DataSource[]
  canonicalModels CanonicalModel[]
  reportConfigs   ReportConfig[]
  teamInvites     TeamInvite[]
  reportTemplates ReportTemplate[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String
  firstName      String
  lastName       String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model TeamInvite {
  id             String       @id @default(uuid())
  email          String
  role           Role         @default(MEMBER)
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

enum DataSourceType {
  MYSQL
  POSTGRESQL
  SHOPIFY
  REST_API
  EXCEL
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model DataSource {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  name              String
  type              DataSourceType
  status            DataSourceStatus @default(ACTIVE)
  configurationJson Json
  schemaJson        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rawTables         RawTable[]
}

model RawTable {
  id                String       @id @default(uuid())
  dataSourceId      String
  dataSource        DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  tableName         String
  syncEnabled       Boolean      @default(true)
  incrementalColumn String?
  primaryKeyColumn  String?
  lastSyncTimestamp DateTime?
  records           RawRecord[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  fieldMappings     FieldMapping[]

  @@unique([dataSourceId, tableName])
}

model RawRecord {
  id              String           @id @default(uuid())
  rawTableId      String
  rawTable        RawTable         @relation(fields: [rawTableId], references: [id], onDelete: Cascade)
  externalId      String?
  data            Json
  createdAt       DateTime         @default(now())
  canonicalRecord CanonicalRecord?

  @@unique([rawTableId, externalId])
}

model CanonicalModel {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  schemaJson     Json?
  mappings       FieldMapping[]
  records        CanonicalRecord[]
  createdAt      DateTime          @default(now())

  @@unique([organizationId, name])
}

model FieldMapping {
  id               String         @id @default(uuid())
  canonicalModelId String
  canonicalModel   CanonicalModel @relation(fields: [canonicalModelId], references: [id], onDelete: Cascade)
  rawTableId       String
  rawTable         RawTable       @relation(fields: [rawTableId], references: [id], onDelete: Cascade)
  mappingRules     Json
  createdAt        DateTime       @default(now())

  @@unique([canonicalModelId, rawTableId])
}

enum CanonicalRecordStatus {
  MAPPED
  UNMAPPED
  ERROR
}

model CanonicalRecord {
  id               String                @id @default(uuid())
  canonicalModelId String
  canonicalModel   CanonicalModel        @relation(fields: [canonicalModelId], references: [id], onDelete: Cascade)
  rawRecordId      String                @unique
  rawRecord        RawRecord             @relation(fields: [rawRecordId], references: [id], onDelete: Cascade)
  data             Json
  status           CanonicalRecordStatus @default(MAPPED)
  createdAt        DateTime              @default(now())
}

model ReportTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean      @default(false)
  layoutConfig   Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reportConfigs  ReportConfig[]
}

model ReportConfig {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  templateId       String?
  template         ReportTemplate?   @relation(fields: [templateId], references: [id])
  name             String
  userQuery        String
  cronSchedule     String
  targetEmails     String[]
  includedModels   String[]
  isActive         Boolean           @default(true)
  executions       ReportExecution[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ReportExecution {
  id               String       @id @default(uuid())
  reportConfigId   String
  reportConfig     ReportConfig @relation(fields: [reportConfigId], references: [id], onDelete: Cascade)
  status           String
  pdfUrl           String?
  errorMessage     String?
  executedAt       DateTime     @default(now())
}
